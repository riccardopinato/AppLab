name: AppLab Project Gate

on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: applab-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  applab:
    uses: riccardopinato/AppLab/.github/workflows/verify-flutter.yml@main
    with:
      run_flutter_tests: true
      run_maestro: true
      # Optional for monorepos:
      # working_directory: apps/mobile
      # Optional app-specific Maestro flow, relative to repository root:
      # maestro_flow: .maestro/applab-smoke.yaml
