name: AppLab

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  applab:
    uses: riccardopinato/AppLab/.github/workflows/verify-flutter.yml@main
    with:
      run_flutter_tests: true
      run_maestro: true
      # Optional: create this file in the app repository for app-specific checks.
      # If omitted, AppLab generates a generic launch -> Home -> relaunch flow.
      # maestro_flow: .maestro/applab-smoke.yaml
