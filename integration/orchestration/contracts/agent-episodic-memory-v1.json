{
  "schema_version": 1,
  "contract_name": "APPLAB_AGENT_EPISODIC_MEMORY",
  "authority": "ADVISORY_STRATEGY_RANKING_ONLY",
  "record_type": "APPLAB_AGENT_EPISODE",
  "required_fields": [
    "schema_version",
    "record_type",
    "episode_id",
    "repository",
    "source_sha",
    "failure_signature",
    "failure_class",
    "surfaces",
    "candidate_files",
    "repair_outcome",
    "successful_patterns",
    "failed_patterns",
    "regression_targets",
    "evidence_refs",
    "source_records"
  ],
  "repair_outcomes": ["PASS", "FAIL", "STOPPED", "BLOCKED", "UNKNOWN"],
  "max_episodes": 5000,
  "max_query_results": 12,
  "invariants": [
    "memory_is_rebuildable_from_source_records",
    "memory_never_becomes_verdict_authority",
    "memory_never_self_modifies_guardrails_or_policy",
    "source_evidence_refs_are_preserved",
    "failed_approaches_are_retained",
    "repository_specific_evidence_is_not_silently_generalized",
    "missing_or_stale_memory_never_blocks_verification"
  ]
}
