ADB_SERIAL=
VITE_BACKEND_URL=http://localhost:8000
VITE_GATEWAY_URI=localhost:8080

# AppLab v0.6.3 Live Emulator (Linux/KVM only)
APPLAB_EMULATOR_IMAGE=applab-emulator-runtime:0.3.1
APPLAB_EMULATOR_BASE_IMAGE=us-docker.pkg.dev/android-emulator-268719/images/30-google-x64-no-metrics:7148297
APPLAB_EMULATOR_PARAMS=-no-window -no-audio -no-boot-anim -gpu swiftshader_indirect
APPLAB_BOOT_TIMEOUT=240
APPLAB_DOCKER_TIMEOUT=1200

# Local controller hardening
APPLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APPLAB_MAX_APK_BYTES=536870912
